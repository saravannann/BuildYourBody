# Build Your Body - Backend Environment Configuration Template

# Server Port
PORT=3000

# Gemini API Key (Required for food analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configurations
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key (highly recommended for server-side environments to bypass RLS policies securely)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
